PORT=4201
NODE_ENV=development

# Firebase service account JSON (local dev fallback; on Cloud Run use ADC instead)
FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"..."}

# Firestore named database — leave empty to use the default (production) database.
# Set to 'dev' (or any named database ID) for the development environment.
FIRESTORE_DATABASE_ID=

GEMINI_API_KEY=your-gemini-api-key

ALLOWED_ORIGINS=http://localhost:4200,http://localhost:4201,capacitor://localhost
